#!/usr/bin/env python3
"""The Devmachine app's door onto a machine, reached through `devmachine run --package devmachine-app`."""
import os
import sys

COMMANDS = {
    "context": "devmachine-infer",
    "stats": "devmachine-stats",
    "caddy-logs": "devmachine-caddy-logs",
}


def main(argv):
    if not argv or argv[0] not in COMMANDS:
        print(f"usage: devmachine-app {{{','.join(COMMANDS)}}} [args...]", file=sys.stderr)
        return 2
    script = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "files", COMMANDS[argv[0]])
    os.execv(sys.executable, [sys.executable, script, *argv[1:]])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
